# ============================================================
#  Simarine Pico monitor — settings
#  The Start launcher fills in PICO_SERIAL and INFLUX_TOKEN for you on first run.
#  The ONLY thing you may want to change by hand: the two passwords below.
# ============================================================

# Your Simarine Pico2 serial number (the launcher asks you for this).
PICO_SERIAL=

# --- logins (change these!) -------------------------------------------------
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme
INFLUX_USER=admin
INFLUX_PASSWORD=changeme8+        # must be at least 8 characters

# --- internal (leave as-is) -------------------------------------------------
INFLUX_ORG=van
INFLUX_BUCKET=pico
INFLUX_RETENTION=365d
INFLUX_TOKEN=                      # the launcher generates a random one on first run
GRAFANA_PORT=3000                 # open the dashboard at http://localhost:3000
# INFLUX_PORT=8086                # change if 8086 is taken on your machine

# --- optional tuning (safe defaults are built in; uncomment to override) ----
# POLL_SECONDS=15
# BATTERY_CAPACITY_AH=            # blank = auto-detected from your Pico
# SOLAR_DEVICE=                   # name of your solar shunt (see the collector log after first run)
# TAIL_CURRENT_A=4                # "really full" tail-current threshold (amps)
# FULL_HOLD_MIN=10
# PICO_SLACK_WEBHOOK=             # paste a Slack incoming-webhook URL to get phone alerts
